# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, add these under Project Settings -> Environment Variables.

# --- Supabase (both are public values, safe in the browser) -----------------
# Project URL: Supabase dashboard -> Project Settings -> API (or `npx supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). NEVER put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App ---------------------------------------------------------------------
# Public origin used in auth emails, e.g. https://project1406.example.com
# Leave empty locally; set it to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=

# Email of the account owner. Server-side only (no NEXT_PUBLIC_ prefix).
# Only this account is offered the IRONMAN California starter plan.
OWNER_EMAIL=
